{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run Portfolio App",
      "request": "launch",
      "mainClass": "com.portfolio.PortfolioApplication",
      "projectName": "portfolio-website",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      },
      "vmArgs": "-Dspring.devtools.restart.enabled=true"
    },
    {
      "type": "java",
      "name": "Debug Portfolio App",
      "request": "launch",
      "mainClass": "com.portfolio.PortfolioApplication",
      "projectName": "portfolio-website",
      "console": "internalConsole"
    }
  ]
}
